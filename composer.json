{
    "name": "vaslv/filament-app-version",
    "description": "Shows your application's version as a chip next to the Filament panel logo — several sources with a priority chain, the panel's own colours, hidden from guests by default",
    "keywords": ["laravel", "filament", "filament-plugin", "version", "release"],
    "homepage": "https://github.com/vaslv/filament-app-version",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrei Vasilev",
            "email": "andrei@vaslv.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/vaslv/filament-app-version/issues",
        "source": "https://github.com/vaslv/filament-app-version"
    },
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vaslv\\FilamentAppVersion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaslv\\FilamentAppVersion\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test",
        "check": [
            "@lint:test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaslv\\FilamentAppVersion\\AppVersionServiceProvider"
            ],
            "aliases": {
                "AppVersion": "Vaslv\\FilamentAppVersion\\Facades\\AppVersion"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
